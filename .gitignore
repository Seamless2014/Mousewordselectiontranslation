# 依赖与构建产物
# 本地 npm install 装的依赖不入库；run-tests.js 也会 fallback 到托管环境
node_modules/
package-lock.json

# 词典构建的中间产物（ECDICT CSV 约 66MB，由 build-dict.js 按需下载生成）
*.csv

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时与诊断文件
_*.js
*.log

# 验收脚本的生成物（每次运行结果不同，仅本地查看见 verify-browser.js / verify-v150.js）
verify-browser-result.json
verify-v150-result.json

# Trae IDE 临时目录
.trae-html-share-packages/
